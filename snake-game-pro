<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Snake Game Pro by Aftab</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box }
    body { background:#222; display:flex; justify-content:center; align-items:center; height:100vh; font-family:Arial; overflow:hidden }
    canvas { background:#111; border:2px solid #0f0; touch-action:none }
    #score { position:fixed; top:20px; color:#0f0; font-size:24px; z-index:99 }
  </style>
</head>
<body>
  <div id="score">Score: 0</div>
  <canvas id="game"></canvas>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');

// Mobile responsive
let size = Math.min(window.innerWidth, window.innerHeight) - 40;
canvas.width = size; canvas.height = size;
const grid = 20;
const tile = canvas.width / grid;

let snake = [{x:10, y:10}];
let food = {x:15, y:15};
let dir = {x:0, y:0};
let score = 0;
let speed = 150;
let loopTimer;

function start() {
  snake = [{x:10, y:10}];
  dir = {x:0, y:0};
  score = 0; speed = 150;
  placeFood();
  clearInterval(loopTimer);
  loopTimer = setInterval(update, speed);
}

function placeFood() {
  food.x = Math.floor(Math.random() * grid);
  food.y = Math.floor(Math.random() * grid);
  for(let s of snake) {
    if(s.x === food.x && s.y === food.y) return placeFood();
  }
}

function update() {
  // Move snake
  const head = {x: snake[0].x + dir.x, y: snake[0].y + dir.y};

  // Wall collision = Game Over
  if(head.x < 0 || head.x >= grid || head.y < 0 || head.y >= grid) return gameOver();

  // Self collision
  for(let s of snake) if(s.x === head.x && s.y === head.y) return gameOver();

  snake.unshift(head);

  // Eat food
  if(head.x === food.x && head.y === food.y) {
    score += 10;
    scoreEl.innerText = 'Score: ' + score;
    if(speed > 50) { clearInterval(loopTimer); speed -= 2; loopTimer = setInterval(update, speed); }
    placeFood();
  } else {
    snake.pop();
  }
  draw();
}

function draw() {
  // Clear
  ctx.fillStyle = '#111';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Food
  ctx.fillStyle = '#f00';
  ctx.fillRect(food.x*tile, food.y*tile, tile-2, tile-2);

  // Snake
  ctx.fillStyle = '#0f0';
  for(let s of snake) {
    ctx.fillRect(s.x*tile, s.y*tile, tile-2, tile-2);
  }
}

function gameOver() {
  clearInterval(loopTimer);
  ctx.fillStyle = 'rgba(0,0,0,0.7)';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.fillStyle = '#f00';
  ctx.font = '40px Arial';
  ctx.textAlign = 'center';
  ctx.fillText('GAME OVER', canvas.width/2, canvas.height/2 - 20);
  ctx.fillStyle = '#fff';
  ctx.font = '20px Arial';
  ctx.fillText('Score: ' + score, canvas.width/2, canvas.height/2 + 10);
  ctx.fillText('Tap to Restart', canvas.width/2, canvas.height/2 + 40);
  canvas.onclick = () => { canvas.onclick = null; start(); };
}

// Swipe Controls
let startX, startY;
canvas.addEventListener('touchstart', e => {
  startX = e.touches[0].clientX;
  startY = e.touches[0].clientY;
});
canvas.addEventListener('touchend', e => {
  let dx = e.changedTouches[0].clientX - startX;
  let dy = e.changedTouches[0].clientY - startY;
  if(Math.abs(dx) > Math.abs(dy)) {
    if(dx > 30 && dir.x!== -1) dir = {x:1, y:0};
    else if(dx < -30 && dir.x!== 1) dir = {x:-1, y:0};
  } else {
    if(dy > 30 && dir.y!== -1) dir = {x:0, y:1};
    else if(dy < -30 && dir.y!== 1) dir = {x:0, y:-1};
  }
});

// Keyboard for PC
document.addEventListener('keydown', e => {
  if(e.key === 'ArrowUp' && dir.y!== 1) dir = {x:0, y:-1};
  if(e.key === 'ArrowDown' && dir.y!== -1) dir = {x:0, y:1};
  if(e.key === 'ArrowLeft' && dir.x!== 1) dir = {x:-1, y:0};
  if(e.key === 'ArrowRight' && dir.x!== -1) dir = {x:1, y:0};
});

start();
</script>
</body>
</html>
